{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ThalesMMS/cooler-compiler/schemas/benchmark-baseline-v1.schema.json",
  "title": "Cooler local performance baseline v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "commit", "toolchain", "platform", "options", "workloads", "samples"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "name": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "minLength": 1 },
    "toolchain": { "type": "string", "minLength": 1 },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "cpu": { "type": "string" }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "benchtime", "benchmark", "webIterations"],
      "properties": {
        "count": { "type": "integer", "minimum": 1, "maximum": 20 },
        "benchtime": { "type": "string", "minLength": 1 },
        "benchmark": { "type": "string", "minLength": 1 },
        "webIterations": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    },
    "workloads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sourceBytes", "sourceUnits"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "sourceBytes": { "type": "integer", "minimum": 0 },
          "sourceUnits": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package", "benchmark", "iteration", "metrics"],
        "properties": {
          "package": { "type": "string", "minLength": 1 },
          "benchmark": { "type": "string", "minLength": 1 },
          "iteration": { "type": "integer", "minimum": 1 },
          "metrics": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "number" }
          }
        }
      }
    }
  }
}
