{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ThalesMMS/cooler-compiler/schemas/release-manifest-v1.schema.json",
  "title": "Cooler local release provenance manifest v1",
  "type": "object",
  "required": ["schemaVersion", "manifestType", "project", "version", "sourceCommit", "sourceDateEpoch", "toolchain", "buildFlags", "packages", "validation"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "manifestType": { "const": "cooler-release" },
    "project": { "const": "cooler-compiler" },
    "version": { "type": "string", "minLength": 1 },
    "sourceCommit": { "type": "string", "pattern": "^[0-9A-Fa-f]{40}$" },
    "sourceDateEpoch": { "type": "integer", "minimum": 1 },
    "toolchain": {
      "type": "object",
      "required": ["goVersion", "hostOS", "hostArch"],
      "properties": {
        "goVersion": { "type": "string", "minLength": 1 },
        "hostOS": { "type": "string", "minLength": 1 },
        "hostArch": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "buildFlags": { "type": "array", "items": { "type": "string" } },
    "packages": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["filename", "byteSize", "sha256", "target", "modes", "validationStatus"],
        "properties": {
          "filename": { "type": "string", "minLength": 1 },
          "byteSize": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "target": {
            "type": "object",
            "required": ["os", "arch"],
            "properties": {
              "os": { "type": "string", "minLength": 1 },
              "arch": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "modes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "validationStatus": { "enum": ["built", "runtime-tested", "native-gui-tested", "source-build-only"] }
        },
        "additionalProperties": false
      }
    },
    "validation": {
      "type": "object",
      "required": ["buildStatus", "runtimeStatus", "skippedChecks", "evidenceDocument"],
      "properties": {
        "buildStatus": { "type": "string", "minLength": 1 },
        "runtimeStatus": { "type": "string", "minLength": 1 },
        "skippedChecks": { "type": "array", "items": { "type": "string" } },
        "evidenceDocument": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
