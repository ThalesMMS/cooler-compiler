{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ThalesMMS/cooler-compiler/schemas/compile-report-v1.schema.json",
  "title": "Cooler complete compilation report v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "compilerVersion",
    "target",
    "options",
    "sourceUnits",
    "source",
    "stages",
    "tokens",
    "symbols",
    "ir",
    "assembly",
    "assemblySpans",
    "metrics",
    "controlFlow",
    "runtime",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "compilerVersion": { "type": "string", "minLength": 1 },
    "compilerCommit": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "required": ["os", "arch", "goVersion"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "goVersion": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "options": {
      "type": "object",
      "required": ["execute", "vmMaxSteps", "inputProvided"],
      "properties": {
        "execute": { "type": "boolean" },
        "vmMaxSteps": { "type": "integer", "minimum": 1 },
        "inputProvided": { "type": "boolean" },
        "vmPolicy": { "$ref": "#/$defs/vmPolicy" },
        "optimization": { "enum": ["none", "basic"] },
        "warningRules": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sourceUnits": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceUnit" }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "name", "content"],
        "properties": {"id": {"type":"string","minLength":1}, "name": {"type":"string","minLength":1}, "content": {"type":"string"}},
        "additionalProperties": false
      }
    },
    "project": {"const":"cooler-compiler"},
    "sourceFile": {"type":"string","minLength":1},
    "exportedAt": {"type":"string","minLength":1},
    "source": { "type": "string" },
    "stages": { "type": "array", "items": { "$ref": "#/$defs/stage" } },
    "tokens": { "type": "array", "items": { "$ref": "#/$defs/token" } },
    "ast": { "type": ["object", "null"] },
    "symbols": { "type": "array" },
    "ir": { "type": "array" },
    "assembly": { "type": "array", "items": { "type": "string" } },
    "assemblySpans": { "type": "array", "items": { "$ref": "#/$defs/span" } },
    "metrics": { "$ref": "#/$defs/metrics" },
    "controlFlow": { "$ref": "#/$defs/controlFlow" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "visualizations": {
      "type": "object",
      "required": ["schemaVersion", "compilerVersion", "sourceUnitIds", "model", "limits", "truncated", "inheritance", "edges", "classes", "artifacts", "groups"],
      "properties": {
        "schemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
        "compilerVersion": { "type": "string", "minLength": 1 },
        "sourceUnitIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "model": { "type": "string", "minLength": 1 },
        "limits": { "type": "object" },
        "truncated": { "type": "boolean" },
        "inheritance": { "type": "array" },
        "edges": { "type": "array" },
        "classes": { "type": "array" },
        "artifacts": { "type": "array" },
        "groups": { "type": "array" }
      },
      "additionalProperties": false
    },
    "optimization": {
      "type": "object",
      "required": ["mode", "enabled", "executionIR", "passOrder", "baselineVerified", "optimizedVerified", "beforeIR", "afterIR", "beforeCFG", "afterCFG", "passes"],
      "properties": {
        "mode": { "enum": ["none", "basic"] },
        "enabled": { "type": "boolean" },
        "executionIR": { "enum": ["unoptimized", "optimized"] },
        "passOrder": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "baselineVerified": { "type": "boolean" },
        "optimizedVerified": { "type": "boolean" },
        "beforeIR": { "type": "array" },
        "afterIR": { "type": "array" },
        "beforeCFG": { "$ref": "#/$defs/controlFlow" },
        "afterCFG": { "$ref": "#/$defs/controlFlow" },
        "passes": { "type": "array", "items": { "$ref": "#/$defs/optimizationPass" } }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {"if":{"properties":{"schemaVersion":{"pattern":"^1\\.[0-4]\\."}}},"then":{"properties":{"sources":false,"options":{"properties":{"warningRules":false}}}}},
    {
      "if": {
        "properties": {
          "schemaVersion": { "pattern": "^1\\.([2-9]|[1-9][0-9]+)\\." }
        }
      },
      "then": {
        "properties": {
          "options": { "required": ["vmPolicy"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": { "pattern": "^1\\.([4-9]|[1-9][0-9]+)\\." }
        }
      },
      "then": {
        "required": ["optimization"],
        "properties": {
          "options": { "required": ["optimization"] }
        }
      }
    }
  ],
  "$defs": {
    "vmPolicy": {
      "type": "object",
      "required": [
        "maxInstructionsPerRun",
        "maxInstructionsTotal",
        "maxOperandStackDepth",
        "maxCallFrameDepth",
        "maxScopeDepth",
        "maxObjectAllocations",
        "maxTraceEntries",
        "maxTraceBytes",
        "maxStringBytes",
        "maxOutputBytes",
        "maxInputBytes",
        "maxInputLines",
        "maxBreakpoints"
      ],
      "properties": {
        "maxInstructionsPerRun": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maxInstructionsTotal": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maxOperandStackDepth": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "maxCallFrameDepth": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "maxScopeDepth": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "maxObjectAllocations": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maxTraceEntries": { "type": "integer", "minimum": 1, "maximum": 50000 },
        "maxTraceBytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "maxStringBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "maxOutputBytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "maxInputBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "maxInputLines": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "maxBreakpoints": { "type": "integer", "minimum": 1, "maximum": 10000 }
      },
      "additionalProperties": false
    },
    "optimizationPass": {
      "type": "object",
      "required": ["contract", "beforeInstructions", "afterInstructions", "transformations", "rejected", "verified", "changes", "rejections"],
      "properties": {
        "contract": {
          "type": "object",
          "required": ["name", "preconditions", "preserves", "analysis", "canAlterInstructions", "canAlterCFG", "canAlterAllocation", "canAlterSourceMapping"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "preconditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "preserves": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "analysis": { "type": "string", "minLength": 1 },
            "canAlterInstructions": { "type": "boolean" },
            "canAlterCFG": { "type": "boolean" },
            "canAlterAllocation": { "type": "boolean" },
            "canAlterSourceMapping": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "beforeInstructions": { "type": "integer", "minimum": 0 },
        "afterInstructions": { "type": "integer", "minimum": 0 },
        "transformations": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "verified": { "type": "boolean" },
        "changes": { "type": "array" },
        "rejections": { "type": "array" }
      },
      "additionalProperties": false
    },
    "sourceUnit": {
      "type": "object",
      "required": ["name", "order", "byteSize", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "byteSize": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "span": {
      "type": "object",
      "required": ["startLine", "startColumn", "endLine", "endColumn", "startOffset", "endOffset"],
      "properties": {
        "sourceId": { "type": "string" },
        "startLine": { "type": "integer", "minimum": 1 },
        "startColumn": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "endColumn": { "type": "integer", "minimum": 1 },
        "startOffset": { "type": "integer", "minimum": 0 },
        "endOffset": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "related": {
      "type": "object",
      "required": ["label", "line", "column", "span"],
      "properties": {
        "label": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "span": { "$ref": "#/$defs/span" }
      },
      "additionalProperties": false
    },
    "quickFix": {
      "type": "object",
      "required": ["title", "replacement", "span"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "replacement": { "type": "string" },
        "span": { "$ref": "#/$defs/span" }
      },
      "additionalProperties": false
    },
    "suggestion": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "required": ["id", "name", "status", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" }
      },
      "additionalProperties": false
    },
    "token": {
      "type": "object",
      "required": ["type", "lexeme", "line", "column", "offset", "span"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "lexeme": { "type": "string" },
        "literal": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "offset": { "type": "integer", "minimum": 0 },
        "span": { "$ref": "#/$defs/span" }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": ["usefulTokens", "astNodes", "classes", "methods", "attributes", "symbols", "irInstructions", "assemblyLines", "basicBlocks", "flowEdges"],
      "properties": {
        "usefulTokens": { "type": "integer", "minimum": 0 },
        "astNodes": { "type": "integer", "minimum": 0 },
        "classes": { "type": "integer", "minimum": 0 },
        "methods": { "type": "integer", "minimum": 0 },
        "attributes": { "type": "integer", "minimum": 0 },
        "symbols": { "type": "integer", "minimum": 0 },
        "irInstructions": { "type": "integer", "minimum": 0 },
        "assemblyLines": { "type": "integer", "minimum": 0 },
        "basicBlocks": { "type": "integer", "minimum": 0 },
        "flowEdges": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "controlFlowBlock": {
      "type": "object",
      "required": ["name", "start", "end", "range", "span"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "method": { "type": "string" },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "range": { "type": "string" },
        "span": { "$ref": "#/$defs/span" }
      },
      "additionalProperties": false
    },
    "controlFlowEdge": {
      "type": "object",
      "required": ["from", "to", "kind", "span"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "span": { "$ref": "#/$defs/span" }
      },
      "additionalProperties": false
    },
    "controlFlow": {
      "type": "object",
      "required": ["blocks", "edges"],
      "properties": {
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/controlFlowBlock" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/controlFlowEdge" } }
      },
      "additionalProperties": false
    },
    "runtimeValue": {
      "type": "object",
      "required": ["type", "display"],
      "properties": {
        "type": { "type": "string" },
        "display": { "type": "string" },
        "object": { "type": "string" }
      },
      "additionalProperties": false
    },
    "runtimeFrame": {
      "type": "object",
      "required": ["functionName", "ip", "self", "locals", "stackBase", "span"],
      "properties": {
        "functionName": { "type": "string" },
        "owner": { "type": "string" },
        "ip": { "type": "integer", "minimum": 0 },
        "self": { "$ref": "#/$defs/runtimeValue" },
        "locals": { "type": "object" },
        "stackBase": { "type": "integer", "minimum": 0 },
        "span": { "$ref": "#/$defs/span" }
      },
      "additionalProperties": false
    },
    "vmState": {
      "type": "object",
      "required": ["step", "ip", "op", "stack", "frames", "output", "note", "span"],
      "properties": {
        "step": { "type": "integer", "minimum": 0 },
        "ip": { "type": "integer", "minimum": 0 },
        "method": { "type": "string" },
        "op": { "type": "string" },
        "stack": { "type": ["array", "null"], "items": { "$ref": "#/$defs/runtimeValue" } },
        "frames": { "type": ["array", "null"], "items": { "$ref": "#/$defs/runtimeFrame" } },
        "output": { "type": ["array", "null"], "items": { "type": "string" } },
        "note": { "type": "string" },
        "span": { "$ref": "#/$defs/span" }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["trace", "executedSteps", "output", "stack", "frames", "halted"],
      "properties": {
        "trace": { "type": "array", "items": { "$ref": "#/$defs/vmState" } },
        "executedSteps": { "type": "integer", "minimum": 0 },
        "traceOffset": { "type": "integer", "minimum": 0 },
        "output": { "type": "array", "items": { "type": "string" } },
        "stack": { "type": "array", "items": { "$ref": "#/$defs/runtimeValue" } },
        "frames": { "type": "array", "items": { "$ref": "#/$defs/runtimeFrame" } },
        "halted": { "type": "boolean" },
        "paused": { "type": "boolean" },
        "waitingInput": { "$ref": "#/$defs/vmInputRequest" },
        "inputEvents": { "type": "integer", "minimum": 0 },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
      },
      "additionalProperties": false
    },
    "vmInputRequest": {
      "type": "object",
      "required": ["sequence", "builtin", "span", "method", "frame", "output", "inputPosition", "preSuppliedRemaining"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "builtin": { "type": "string", "minLength": 1 },
        "span": { "$ref": "#/$defs/span" },
        "method": { "type": "string", "minLength": 1 },
        "frame": { "type": "integer", "minimum": 0 },
        "output": { "type": ["array", "null"], "items": { "type": "string" } },
        "inputPosition": { "type": "integer", "minimum": 0 },
        "preSuppliedRemaining": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["stage", "severity", "message", "line", "column", "span"],
      "properties": {
        "code": { "type": "string" },
        "stage": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["error", "warning", "info"] },
        "message": { "type": "string" },
        "hint": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "span": { "$ref": "#/$defs/span" },
        "related": { "type": "array", "items": { "$ref": "#/$defs/related" } },
        "quickFixes": { "type": "array", "items": { "$ref": "#/$defs/quickFix" } },
        "suggestions": { "type": "array", "items": { "$ref": "#/$defs/suggestion" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
