{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ThalesMMS/cooler-compiler/schemas/report-archive-manifest-v1.schema.json",
  "title": "Cooler report ZIP manifest v1",
  "type": "object",
  "required": ["schemaVersion", "manifestType", "compilerVersion", "documentName", "sourceUnits", "artifacts", "creation"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "manifestType": { "const": "cooler-report-archive" },
    "compilerVersion": { "type": "string", "minLength": 1 },
    "compilerCommit": { "type": "string", "minLength": 1 },
    "documentName": { "type": "string", "minLength": 1 },
    "sourceUnits": { "type": "array" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "byteSize", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "byteSize": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "creation": {
      "type": "object",
      "required": ["timestampPolicy", "generatedTextNewlines", "sourceAndProgramOutput"]
    }
  },
  "additionalProperties": false
}
