Program text="2 classes"
  Class name=Base type=Object text="class Base"
  Class name=Main type=Base text="class Main inherits Base"
    Attribute name=value type=Int text="value : Int"
    Attribute name=initialized type=Int text="initialized : Int"
      Int value="1" text="1"
    Method name=zero type=Int text="zero(...) : Int"
      Int value="0" text="0"
    Method name=one type=Int text="one(...) : Int"
      Formal name=x type=Int text="x : Int"
      Identifier name=x text="x"
    Method name=many type=Int text="many(...) : Int"
      Formal name=x type=Int text="x : Int"
      Formal name=y type=Int text="y : Int"
      Formal name=z type=Int text="z : Int"
      Binary text="PLUS"
        Identifier name=x text="x"
        Binary text="STAR"
          Identifier name=y text="y"
          Identifier name=z text="z"
    Method name=main type=Object text="main(...) : Object"
      Block text="{ … }"
        Assignment text="value <-"
          Dispatch text="many(...)"
            Int value="1" text="1"
            Int value="2" text="2"
            Int value="3" text="3"
        Dispatch text="@Main.one(...)"
          Identifier name=self text="self"
          Identifier name=value text="value"
        Dispatch text="zero(...)"
          New text="new Main"
        If text="if … then … else … fi"
          Unary text="NOT"
            Bool value="false" text="false"
          Identifier name=value text="value"
          Int value="0" text="0"
        While text="while … loop … pool"
          Bool value="false" text="false"
          Assignment text="value <-"
            Binary text="PLUS"
              Identifier name=value text="value"
              Int value="1" text="1"
        Let text="let … in …"
          LetBinding name=item type=Base text="item : Base"
            New text="new Main"
          LetBinding name=other type=Int text="other : Int"
          IsVoid text="isvoid"
            Identifier name=item text="item"
        Case text="case … of … esac"
          Identifier name=self text="self"
          CaseBranch name=main type=Main text="main : Main"
            Identifier name=main text="main"
          CaseBranch name=base type=Base text="base : Base"
            Identifier name=base text="base"
        New text="new SELF_TYPE"
