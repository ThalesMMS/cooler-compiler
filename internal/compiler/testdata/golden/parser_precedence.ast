Program text="1 class"
  Class name=Main type=Object text="class Main"
    Method name=main type=Object text="main(...) : Object"
      Formal name=a type=Int text="a : Int"
      Formal name=b type=Int text="b : Int"
      Formal name=c type=Int text="c : Int"
      Formal name=obj type=Object text="obj : Object"
      Block text="{ … }"
        Assignment text="a <-"
          Assignment text="b <-"
            Unary text="NOT"
              Binary text="LESS"
                Identifier name=a text="a"
                Binary text="PLUS"
                  Identifier name=b text="b"
                  Binary text="STAR"
                    Identifier name=c text="c"
                    IsVoid text="isvoid"
                      Unary text="TILDE"
                        Dispatch text="type_name(...)"
                          Dispatch text="@Object.copy(...)"
                            Identifier name=obj text="obj"
        Binary text="STAR"
          Binary text="PLUS"
            Identifier name=a text="a"
            Identifier name=b text="b"
          Identifier name=c text="c"
